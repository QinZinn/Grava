# Maintainer: Zinnn <139782520+QinZinn@users.noreply.github.com>

pkgname=grava
pkgver=0.1.0
pkgrel=1
pkgdesc='Terminal audio visualizer that draws Chladni figures with sand'
arch=('x86_64' 'aarch64')
url='https://github.com/QinZinn/Grava'
license=('MIT')
depends=('gcc-libs')
makedepends=('cargo')
optdepends=('pipewire-pulse: record the output on a PipeWire desktop'
            'pulseaudio: record the output on a PulseAudio desktop')
# The archive of a GitHub tag unpacks to Grava-$pkgver.
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('991acb457625f23005345cbc1dba9c5ffd118843195bccdfecb1847702afabec')

# The default build is pure Rust. For the optional native backends add
# 'libpipewire' 'alsa-lib' 'clang' to makedepends, append
# --features pipewire,alsa to the cargo commands below, and list 'libpipewire'
# and 'alsa-lib' in depends.

prepare() {
  cd "Grava-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "Grava-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "Grava-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen
}

package() {
  cd "Grava-$pkgver"
  local grava=target/release/grava

  install -Dm755 "$grava" "$pkgdir/usr/bin/grava"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 assets/config.toml "$pkgdir/usr/share/doc/$pkgname/config.toml"

  "$grava" --man | install -Dm644 /dev/stdin "$pkgdir/usr/share/man/man1/grava.1"
  "$grava" --completions bash | install -Dm644 /dev/stdin \
    "$pkgdir/usr/share/bash-completion/completions/grava"
  "$grava" --completions zsh | install -Dm644 /dev/stdin \
    "$pkgdir/usr/share/zsh/site-functions/_grava"
  "$grava" --completions fish | install -Dm644 /dev/stdin \
    "$pkgdir/usr/share/fish/vendor_completions.d/grava.fish"
}
