# Maintainer: Zinnn <139782520+QinZinn@users.noreply.github.com>

pkgname=grava-git
pkgver=0.1.0.r2.g7d7c81a
pkgrel=1
pkgdesc='Terminal audio visualizer that draws Chladni figures with sand (git version)'
arch=('x86_64' 'aarch64')
url='https://github.com/QinZinn/Grava'
license=('MIT')
depends=('gcc-libs')
makedepends=('cargo' 'git')
optdepends=('pipewire-pulse: record the output on a PipeWire desktop'
            'pulseaudio: record the output on a PulseAudio desktop')
provides=('grava')
conflicts=('grava')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

# See the grava PKGBUILD for the optional pipewire and alsa backends.

pkgver() {
  cd "$pkgname"
  # The manifest version plus the total commit count and short revision.
  local version
  version="$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n 1)"
  printf '%s.r%s.g%s' "$version" \
    "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen
}

package() {
  cd "$pkgname"
  local grava=target/release/grava

  install -Dm755 "$grava" "$pkgdir/usr/bin/grava"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/grava/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/grava/README.md"
  install -Dm644 assets/config.toml "$pkgdir/usr/share/doc/grava/config.toml"

  "$grava" --man | install -Dm644 /dev/stdin "$pkgdir/usr/share/man/man1/grava.1"
  "$grava" --completions bash | install -Dm644 /dev/stdin \
    "$pkgdir/usr/share/bash-completion/completions/grava"
  "$grava" --completions zsh | install -Dm644 /dev/stdin \
    "$pkgdir/usr/share/zsh/site-functions/_grava"
  "$grava" --completions fish | install -Dm644 /dev/stdin \
    "$pkgdir/usr/share/fish/vendor_completions.d/grava.fish"
}
