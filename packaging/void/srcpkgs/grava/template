# Template file for 'grava'.
pkgname=grava
version=0.1.0
revision=1
build_style=cargo
# The default build is pure Rust. For the optional native backends use
#   make_build_args="--features pipewire,alsa"
#   makedepends="pipewire-devel alsa-lib-devel clang"
# (add pkg-config to hostmakedepends as well).
short_desc="Terminal audio visualizer that draws Chladni figures with sand"
maintainer="Zinnn <139782520+QinZinn@users.noreply.github.com>"
license="MIT"
homepage="https://github.com/QinZinn/Grava"
distfiles="https://github.com/QinZinn/Grava/archive/refs/tags/v${version}.tar.gz"
checksum=991acb457625f23005345cbc1dba9c5ffd118843195bccdfecb1847702afabec

post_install() {
	vlicense LICENSE
	vdoc README.md
	vdoc assets/config.toml
	# The completions and the manual page come from the binary itself, which
	# cannot run when cross compiling.
	if [ -z "$CROSS_BUILD" ]; then
		local grava=target/${RUST_TARGET}/release/grava
		for shell in bash zsh fish; do
			${grava} --completions ${shell} > grava.${shell}
			vcompletion grava.${shell} ${shell}
		done
		${grava} --man > grava.1
		vman grava.1
	fi
}
